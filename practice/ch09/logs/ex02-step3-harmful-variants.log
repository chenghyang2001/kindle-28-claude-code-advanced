== 改成 bool(order.get("vip"))
DIFF apply_discount {'vip': 'yes', 'items': [{'price': 100, 'qty': 1}]} ('ok', 100) -> ('ok', 90.0)
DIFF is_vip {'vip': 'yes', 'items': [{'price': 100, 'qty': 1}]} ('ok', False) -> ('ok', True)
DIFF apply_discount+coupons {'vip': 'yes', 'items': [{'price': 100, 'qty': 1}]} ('ok', 90) -> ('ok', 80.0)
