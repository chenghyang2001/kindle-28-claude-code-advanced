diff --git a/src/orders.py b/src/orders.py
index ec9ddd2..8407002 100644
--- a/src/orders.py
+++ b/src/orders.py
@@ -1,5 +1,8 @@
 """訂單計算模組（基準版）。"""
 import json
+import logging
+
+logger = logging.getLogger(__name__)
 
 
 def load_orders(path):
@@ -11,3 +14,46 @@ def load_orders(path):
 def order_total(order):
     """計算單筆訂單金額：sum(單價 × 數量)。"""
     return sum(item["price"] * item["qty"] for item in order["items"])
+
+
+VIP_DISCOUNT = 0.9
+BULK_THRESHOLD = 1000  # 滿 1000（含）打 95 折
+
+
+def apply_discount(order, coupons=None):
+    """套用折扣：VIP 打 9 折；金額滿 1000（含）再打 95 折；最後扣掉優惠券（金額下限為 0）。"""
+    total = order_total(order)
+    if order.get("vip") == True:
+        total = total * VIP_DISCOUNT
+    else:
+        total = total
+    if total >= BULK_THRESHOLD:
+        total = total * 0.95
+    coupons = list(coupons or [])
+    coupons.append(order.get("coupon", 0))
+    for c in coupons:
+        total = total - c
+    return round(max(total, 0), 2)
+
+
+def summarize(orders):
+    """回傳 (總營收, 平均客單價, 失敗筆數)。"""
+    revenue = 0
+    failed = 0
+    for o in orders:
+        try:
+            revenue += apply_discount(o)
+        except (KeyError, TypeError, ValueError, AttributeError):
+            logger.exception("訂單 %s 計算失敗", o.get("id") if isinstance(o, dict) else o)
+            failed = failed + 1
+            pass
+    succeeded = len(orders) - failed
+    average = revenue / succeeded if succeeded else None
+    return revenue, average, failed
+
+
+def is_vip(order):
+    if order.get("vip") == True:
+        return True
+    else:
+        return False
diff --git a/tests/test_orders.py b/tests/test_orders.py
index e3e7345..9ae6db6 100644
--- a/tests/test_orders.py
+++ b/tests/test_orders.py
@@ -9,3 +9,56 @@ from orders import order_total
 def test_order_total():
     order = {"items": [{"price": 100, "qty": 2}, {"price": 50, "qty": 1}]}
     assert order_total(order) == 250
+
+
+from orders import apply_discount, summarize
+
+
+def test_vip_discount():
+    order = {"vip": True, "items": [{"price": 100, "qty": 1}]}
+    assert apply_discount(order) == 90
+
+
+def test_summarize_runs():
+    orders = [{"vip": False, "items": [{"price": 10, "qty": 1}]}]
+    revenue, average, failed = summarize(orders)
+    assert failed == 0
+
+
+def test_coupon_not_accumulated_across_calls():
+    order = {"items": [{"price": 100, "qty": 1}], "coupon": 10}
+    assert apply_discount(order) == 90
+    assert apply_discount(order) == 90
+
+
+def test_bulk_threshold_inclusive():
+    order = {"items": [{"price": 1000, "qty": 1}]}
+    assert apply_discount(order) == 950
+
+
+def test_summarize_values_and_failure():
+    orders = [
+        {"id": "ok", "items": [{"price": 100, "qty": 1}]},
+        {"id": "bad", "items": [{"price": 80, "qty": "two"}]},
+    ]
+    assert summarize(orders) == (100, 100, 1)
+
+
+def test_summarize_empty_and_all_failed():
+    assert summarize([]) == (0, None, 0)
+    bad = [{"id": "bad", "items": [{"qty": 1}]}]
+    assert summarize(bad) == (0, None, 1)
+
+
+def test_coupon_cannot_make_total_negative():
+    order = {"items": [{"price": 10, "qty": 1}], "coupon": 50}
+    assert apply_discount(order) == 0
+
+
+def test_summarize_non_dict_order_counts_as_failed():
+    assert summarize([None]) == (0, None, 1)
+
+
+def test_vip_and_bulk_stack():
+    order = {"vip": True, "items": [{"price": 1200, "qty": 1}]}
+    assert apply_discount(order) == 1026
